      "preparacion": "Entrégalos limpios y secos: enjuaga envases, aplasta botellas y cajas para que ocupen menos espacio."
    },
    "no_reciclable": {
      "nombre": "Inorgánicos no reciclables",
      "color": "naranja",
      "dias": "lunes, miércoles, viernes y domingo",
